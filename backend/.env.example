# MongoDB Atlas connection string (never commit real credentials)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sunrise?retryWrites=true&w=majority

# JWT secret — change in production
JWT_SECRET=change-me-sunrise-secret
JWT_EXPIRES_IN=8h

PORT=5000

# Client origin for CORS (Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# Mock booking service: probability (0-1) a simulated final booking fails
BOOKING_FAILURE_RATE=0.2
